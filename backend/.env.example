# ─── LLM Provider ─────────────────────────────────────────────────────────────
# "openai" uses the OpenAI API (or any compatible endpoint like Groq, Together)
# "ollama" uses a local Ollama instance at http://localhost:11434
LLM_PROVIDER=openai

# API key — required for OpenAI/Groq/Together; leave blank for Ollama
LLM_API_KEY=sk-your-key-here

# Model to use (gpt-4o-mini is fast and cost-effective for this use case)
LLM_MODEL=gpt-4o-mini

# Override the base URL to use a different provider's OpenAI-compatible endpoint:
#   Groq:       https://api.groq.com/openai/v1
#   Together:   https://api.together.xyz/v1
#   Ollama:     http://localhost:11434/v1
# LLM_BASE_URL=https://api.openai.com/v1

# Request timeout in seconds (increase for large models)
LLM_TIMEOUT=30

# Retry count on transient errors
LLM_MAX_RETRIES=3

# ─── Flask ────────────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-before-production

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (default for development)
DATABASE_URL=sqlite:///debug_dojo.db

# PostgreSQL example (for production):
# DATABASE_URL=postgresql://user:password@localhost:5432/debug_dojo
