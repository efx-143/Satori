# ─── LLM Configuration ────────────────────────────────────────────────────────
# Supported Providers:
#   "gemini"   -> Google Gemini Native API (Recommended, generous free limits)
#   "groq"     -> Groq (Ultra-fast inference, Llama 3.3 70B, free tier)
#   "openai"   -> OpenAI (gpt-4o-mini, gpt-4o)
#   "ollama"   -> Local Ollama (e.g., http://localhost:11434/v1)

LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-1.5-flash

# --- Option A: Google Gemini (Default) ---
# LLM_PROVIDER=gemini
# LLM_API_KEY=your_gemini_key_here
# LLM_MODEL=gemini-1.5-flash

# --- Option B: Groq (Ultra-fast & free) ---
# LLM_PROVIDER=groq
# LLM_API_KEY=gsk_your_groq_key_here
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_BASE_URL=https://api.groq.com/openai/v1

# --- Option C: OpenAI ---
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-your_openai_key_here
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1

# Request timeout in seconds
LLM_TIMEOUT=30
LLM_MAX_RETRIES=3

# ─── Flask ────────────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=hackathon-debug-dojo-secret-key-2026

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///debug_dojo.db
